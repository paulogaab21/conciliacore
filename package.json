{
  "name": "conciliacore",
  "version": "0.1.0",
  "private": true,
  "description": "Payment reconciliation with webhook ingestion, a transactional outbox, and exception management.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests e2e prisma scripts/generate-icons.ts scripts/send-demo-webhooks.ts next.config.ts playwright.config.ts vitest.config.mts vitest.integration.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:icons": "node --import tsx scripts/generate-icons.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "worker": "node --conditions=react-server --import tsx src/worker.ts",
    "demo:emit": "node --conditions=react-server --import tsx scripts/send-demo-webhooks.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node --conditions=react-server --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dotenv": "17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prisma": "6.12.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
